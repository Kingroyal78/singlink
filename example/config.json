{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "services": [
    {
      "type": "v2board",
      "tag": "v2board",
      "api_host": "https://panel.example.com",
      "api_key": "REPLACE_WITH_V2BOARD_NODE_TOKEN",
      "api_version": 1,
      "api_style": "uniproxy",
      "timeout": "30s",
      "listen": "0.0.0.0",
      "tcp_fast_open": false,
      "pull_interval": "1m",
      "push_interval": "1m",
      "node_report_min_traffic": 0,
      "device_online_min_traffic": 200,
      "tls": {
        "mode": "none"
      },
      "multiplex": {
        "enabled": true,
        "padding": true
      },
      "nodes": [
        {
          "tag": "v2board-shadowsocks-1",
          "node_id": 1,
          "node_type": "shadowsocks"
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
